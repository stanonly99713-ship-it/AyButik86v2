# Скопируйте в .env.local и заполните реальными значениями.
# .env.local и .env* в git не попадают (см. .gitignore) — секреты сюда не пишем.

# Connection string из Neon (Dashboard → Connect → и лучше "pooled connection")
DATABASE_URL=

# Логин/пароль для первого администратора — используются только скриптом
# db:seed при создании строки settings. После сидирования можно убрать.
ADMIN_LOGIN=mama
ADMIN_PASSWORD=

# Секрет для подписи сессионных JWT админки. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Публичный адрес сайта — подставляется в ссылки WhatsApp и метаданные.
# Для локальной разработки можно оставить как есть.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Хранилище фото товаров — Vercel Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=

# Необязательно: номер счётчика с metrika.yandex.ru — без него аналитика просто не подключается
NEXT_PUBLIC_YANDEX_METRIKA_ID=
